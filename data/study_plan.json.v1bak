    "type": "fill_in_blank",
    "question": "Will the new rules _____ me?  (context: To influence or alter)",
    "options": [
     "period",
     "affect",
     "goals",
     "shift"
    ],
    "answer": "affect",
    "explanation": "'affect' means: To influence or alter. Example: Will the new rules affect me?"
