    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'create' (Create or manufacture a man-made product)?",
    "options": [
     "produce",
     "sanguinary",
     "havoc",
     "valid"
    ],
    "answer": "produce",
    "explanation": "'produce' shares the meaning of 'create': Create or manufacture a man-made product."
