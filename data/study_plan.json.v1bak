    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'domestic' (Of or relating to the home)?",
    "options": [
     "home",
     "defalcate",
     "implicit",
     "method"
    ],
    "answer": "home",
    "explanation": "'home' shares the meaning of 'domestic': Of or relating to the home."
   }
