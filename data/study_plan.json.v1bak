    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'designed' (Make or work out a plan for; devise)?",
    "options": [
     "revolutionizes",
     "dare",
     "decathlon",
     "plan"
    ],
    "answer": "plan",
    "explanation": "'plan' shares the meaning of 'designed': Make or work out a plan for; devise."
   }
