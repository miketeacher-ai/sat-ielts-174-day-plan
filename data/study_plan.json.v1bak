   {
    "type": "fill_in_blank",
    "question": "He has the _____ to issue warrants  (context: The power or right to give orders or make decisions)",
    "options": [
     "instance",
     "authority",
     "premier",
     "structure"
    ],
    "answer": "authority",
    "explanation": "'authority' means: The power or right to give orders or make decisions. Example: He has the authority to issue warrants"
   },
