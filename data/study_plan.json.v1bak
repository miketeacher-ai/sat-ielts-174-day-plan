    "type": "fill_in_blank",
    "question": "The results clearly showed _____.  (context: Someone who originates or causes or initiates something)",
    "options": [
     "stress",
     "potential",
     "initial",
     "author"
    ],
    "answer": "author",
    "explanation": "'author' means: Someone who originates or causes or initiates something. Example: He was the generator of several complaints"
   },
