   {
    "type": "fill_in_blank",
    "question": "A border of _____ flowering plants  (context: Completing its life cycle within a year)",
    "options": [
     "perspective",
     "similar",
     "guess",
     "annual"
    ],
    "answer": "annual",
    "explanation": "'annual' means: Completing its life cycle within a year. Example: A border of annual flowering plants"
   },
   {
    "type": "definition_match",
    "question": "Which word means: 'To formally introduce, as to the public'?",
    "options": [
     "anxious",
     "debut",
     "confirms",
     "notion"
    ],
    "answer": "debut",
    "explanation": "'debut' means: To formally introduce, as to the public. Example: The band debuts a new song or two each month"
   }
  ]
