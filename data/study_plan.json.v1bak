    "type": "fill_in_blank",
    "question": "The results clearly showed _____.  (context: (of ideas, images, representations, expressions) characterized by perfect conformity to fact or truth ; strictly correct)",
    "options": [
     "seeking",
     "accurate",
     "gender",
     "pacific"
    ],
    "answer": "accurate",
    "explanation": "'accurate' means: (of ideas, images, representations, expressions) characterized by perfect conformity to fact or truth ; strictly correct. Example: A precise image"
   },
