    "type": "fill_in_blank",
    "question": "The results clearly showed _____.  (context: A hostile meeting of opposing military forces in the course of a war)",
    "options": [
     "mode",
     "abnormal",
     "respond",
     "conflict"
    ],
    "answer": "conflict",
    "explanation": "'conflict' means: A hostile meeting of opposing military forces in the course of a war. Example: Grant won a decisive victory in the battle of chickamauga"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'financial' (Pertaining or\u00a0relating\u00a0to\u00a0money\u00a0matters)?",
    "options": [
     "credulous",
     "delirious",
     "raucous",
     "fiscal"
    ],
    "answer": "fiscal",
    "explanation": "'fiscal' shares the meaning of 'financial': Pertaining or\u00a0relating\u00a0to\u00a0money\u00a0matters."
