   {
    "type": "fill_in_blank",
    "question": "The preachers and the bootleggers found they had a _____ of interests  (context: Agreement as to goals)",
    "options": [
     "method",
     "vision",
     "removed",
     "community"
    ],
    "answer": "community",
    "explanation": "'community' means: Agreement as to goals. Example: The preachers and the bootleggers found they had a community of interests"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'fees' (Give a tip or gratuity to in return for a service, beyond the compensation agreed on)?",
    "options": [
     "reveal",
     "tip",
     "miscellany",
     "terse"
    ],
    "answer": "tip",
    "explanation": "'tip' shares the meaning of 'fees': Give a tip or gratuity to in return for a service, beyond the compensation agreed on."
   }
  ]
