  "exercises": [
   {
    "type": "fill_in_blank",
    "question": "The results clearly showed _____.  (context: The principal activity in your life that you do to earn money)",
    "options": [
     "functions",
     "job",
     "opposite",
     "section"
    ],
    "answer": "job",
    "explanation": "'job' means: The principal activity in your life that you do to earn money. Example: He's not in my line of business"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'core' (The choicest or most essential or most vital part of some idea or experience)?",
    "options": [
     "opponent",
     "anticipation",
     "dissatisfy",
     "kernel"
    ],
    "answer": "kernel",
    "explanation": "'kernel' shares the meaning of 'core': The choicest or most essential or most vital part of some idea or experience."
   }
  ]
