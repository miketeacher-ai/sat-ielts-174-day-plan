   {
    "type": "fill_in_blank",
    "question": "The results clearly showed _____.  (context: A collection of things sharing a common attribute)",
    "options": [
     "category",
     "published",
     "legal",
     "theme"
    ],
    "answer": "category",
    "explanation": "'category' means: A collection of things sharing a common attribute. Example: There are two classes of detergents"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'error' (A wrong action attributable to bad judgment or ignorance or inattention)?",
    "options": [
     "lexicographer",
     "facility",
     "mistake",
     "equivalent"
    ],
    "answer": "mistake",
    "explanation": "'mistake' shares the meaning of 'error': A wrong action attributable to bad judgment or ignorance or inattention."
   }
  ]
