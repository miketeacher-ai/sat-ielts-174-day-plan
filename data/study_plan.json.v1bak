   {
    "type": "fill_in_blank",
    "question": "I concluded from his awkward _____s that he was a foreigner  (context: A group of words that form a constituent of a sentence and are considered as a single unit)",
    "options": [
     "normal",
     "academia",
     "revolution",
     "construction"
    ],
    "answer": "construction",
    "explanation": "'construction' means: A group of words that form a constituent of a sentence and are considered as a single unit. Example: I concluded from his awkward constructions that he was a foreigner"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'foreign' (From a different country)?",
    "options": [
     "recurrent",
     "strange",
     "testament",
     "heretic"
    ],
    "answer": "strange",
    "explanation": "'strange' shares the meaning of 'foreign': From a different country."
   }
  ]
