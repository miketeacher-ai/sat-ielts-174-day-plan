    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'cycle' (An interval during which a recurring sequence of events occurs)?",
    "options": [
     "sequentially",
     "rhythm",
     "verisimilitude",
     "salutary"
    ],
    "answer": "rhythm",
    "explanation": "'rhythm' shares the meaning of 'cycle': An interval during which a recurring sequence of events occurs."
