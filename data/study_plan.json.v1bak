   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'federal' (Being of or having to do with the northern united states and those loyal to the union during the american civil war)?",
    "options": [
     "irreproachable",
     "equated",
     "union",
     "gouge"
    ],
    "answer": "union",
    "explanation": "'union' shares the meaning of 'federal': Being of or having to do with the northern united states and those loyal to the union during the american civil war."
