    "type": "fill_in_blank",
    "question": "The results clearly showed _____.  (context: The activity of contributing to the fulfillment of a need or furtherance of an effort or purpose)",
    "options": [
     "grade",
     "permanent",
     "significant",
     "aid"
    ],
    "answer": "aid",
    "explanation": "'aid' means: The activity of contributing to the fulfillment of a need or furtherance of an effort or purpose. Example: He gave me an assist with the housework"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'data' (A collection of facts from which conclusions may be drawn)?",
    "options": [
     "information",
     "insert",
     "supple",
     "emaciate"
    ],
    "answer": "information",
    "explanation": "'information' shares the meaning of 'data': A collection of facts from which conclusions may be drawn."
   }
