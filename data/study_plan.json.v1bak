    "type": "fill_in_blank",
    "question": "We were _____ing our destination  (context: Move towards)",
    "options": [
     "impact",
     "physical",
     "source",
     "approach"
    ],
    "answer": "approach",
    "explanation": "'approach' means: Move towards. Example: We were approaching our destination"
   },
   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'design' (An anticipated outcome that is intended or that guides your planned actions)?",
    "options": [
     "link",
     "purpose",
     "peregrination",
     "publication"
    ],
    "answer": "purpose",
    "explanation": "'purpose' shares the meaning of 'design': An anticipated outcome that is intended or that guides your planned actions."
   }
