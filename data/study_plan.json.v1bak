   {
    "type": "synonym_match",
    "question": "Which word is closest in meaning to 'estate' (Extensive landed property (especially in the country) retained by the owner for his own use)?",
    "options": [
     "concomitant",
     "land",
     "unanimity",
     "edits"
    ],
    "answer": "land",
    "explanation": "'land' shares the meaning of 'estate': Extensive landed property (especially in the country) retained by the owner for his own use."
   }
