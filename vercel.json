{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": { "includeFiles": "data/**" },
    "api/day/*.py": { "includeFiles": "data/**" },
    "api/exercise/*.py": { "includeFiles": "data/**" }
  },
  "rewrites": [{ "source": "/", "destination": "/static/index.html" }]
}
